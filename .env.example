# Credentials for cypress/e2e/examples/ (the smoke suite needs none of this).
# Read via cy.env('WIKI_USERNAME') / cy.env('WIKI_PASSWORD') - see cypress/utils/env.js.
#
# Locally: run `npm run setup:env` to create cypress.env.json from
# cypress.env.example.json, then fill in a disposable test account.
#
# In CI: set these as CYPRESS_-prefixed environment variables / GitHub Actions
# secrets - Cypress strips the CYPRESS_ prefix automatically.
CYPRESS_WIKI_USERNAME=your-test-account-username
CYPRESS_WIKI_PASSWORD=your-test-account-password

# Never use a personal or production Wikipedia account here.
